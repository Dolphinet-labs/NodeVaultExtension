# Copy this file to `.env` and fill in values locally.
# Never commit `.env` or any secrets (Infura / API keys / private keys).
#
# Build-time configuration (read by webpack):
# - WEBSITE origin used in manifest/homepage_url and some UI links.
WIGWAM_WEBSITE_ORIGIN=https://chain.dolphinode.world/wallet
# Redeem backend origin (used by NFT Redeem flow)
REDEEM_API_ORIGIN=https://redeem.dolphinode.world
#
# Optional API keys (leave empty if not needed for your environment):
WIGWAM_INFURA_API_KEY=
WIGWAM_INDEXER_API=
WIGWAM_INDEXER_API_KEY=
WIGWAM_ANALYTICS_API_KEY=
WIGWAM_OPEN_LOGIN_CLIENT_ID=
WIGWAM_ON_RAMP_API_URL=
WIGWAM_ON_RAMP_API_KEY=


